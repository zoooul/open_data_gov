{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/zoooul/open_data_gov/schemas/datasets.schema.json",
  "title": "Open Data Gov dataset index",
  "description": "Generated by scripts/build_dataset_index.py. One row per dataset described in this repository.",
  "type": "object",
  "required": ["schema_version", "generated_by", "count", "datasets"],
  "properties": {
    "schema_version": {"type": "string"},
    "generated_by": {"type": "string"},
    "description": {"type": "string"},
    "count": {"type": "integer", "minimum": 1},
    "datasets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "topic", "kind", "url", "access", "license_id", "commercial_use", "documentation_checked_at", "doc"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
          "name": {"type": "string", "minLength": 1},
          "topic": {"enum": ["directory-candidates", "education", "psychotherapy-hypnosis", "esotericism-history"]},
          "kind": {"enum": ["directory_candidate", "source_profile"]},
          "url": {"type": "string", "format": "uri"},
          "download_url": {"type": ["string", "null"], "format": "uri"},
          "formats": {"type": "array", "items": {"type": "string"}},
          "access": {"enum": ["bulk_download", "api", "bulk_and_api", "search_only", "provider_feed", "reference", "software"]},
          "license_id": {"type": "string"},
          "license_note": {"type": ["string", "null"]},
          "license_evidence_url": {"type": ["string", "null"]},
          "commercial_use": {"enum": ["yes", "conditional", "no", "unknown"]},
          "attribution_required": {"type": ["boolean", "null"]},
          "share_alike": {"type": ["boolean", "null"]},
          "count_value": {"type": ["integer", "null"], "minimum": 0},
          "count_relation": {"enum": ["eq", "gt", null]},
          "count_unit": {"type": ["string", "null"]},
          "count_scope": {"type": ["string", "null"]},
          "count_basis": {"type": ["string", "null"]},
          "measured_record_count": {"type": ["integer", "null"], "minimum": 0},
          "measured_unique_ids": {"type": ["integer", "null"], "minimum": 0},
          "measured_at": {"type": ["string", "null"], "format": "date"},
          "documentation_checked_at": {"type": "string", "format": "date"},
          "doc": {"type": "string"},
          "notes": {"type": ["string", "null"]}
        }
      }
    }
  }
}
